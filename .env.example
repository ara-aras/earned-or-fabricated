# Copy to .env (never commit .env). Without these the code talks to a local Ollama server.
# Groq (OpenAI-compatible API)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b
# Model the web audit endpoint uses (model@base_url form also works)
AUDIT_LLM=openai/gpt-oss-20b@https://api.groq.com/openai/v1
# gpt-oss models reason before answering; 'low' is the default for them here (about 2 s per rewrite).
# LLM_REASONING_EFFORT=low
